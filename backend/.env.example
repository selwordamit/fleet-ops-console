# Copy to .env and fill in values

APP_NAME=Fleet Operations Console
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# Phase 02B — Database
# Async SQLAlchemy connection string (asyncpg driver). Matches docker-compose postgres defaults.
# These localhost values are for running the backend ON THE HOST (Postgres/Redis in Docker).
# When the backend itself runs as a container, docker-compose overrides these with the
# in-network service hostnames:
#   DATABASE_URL=postgresql+asyncpg://fleetops:fleetops@postgres:5432/fleetops
#   REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://fleetops:fleetops@localhost:5432/fleetops

# Phase 02C — Redis
# Connection string. Matches the docker-compose redis service.
REDIS_URL=redis://localhost:6379/0

# Phase 09 — Alerts
# Battery percentage below which a low_battery alert is triggered.
LOW_BATTERY_THRESHOLD=15

# Phase 11 — Auth
# SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
