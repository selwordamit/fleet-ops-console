# Copy to .env and fill in values

APP_NAME=Fleet Operations Console
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# Phase 02B — Database
# Async SQLAlchemy connection string (asyncpg driver). Matches docker-compose postgres defaults.
DATABASE_URL=postgresql+asyncpg://fleetops:fleetops@localhost:5432/fleetops

# Phase 02C — Redis
# Connection string. Matches the docker-compose redis service.
REDIS_URL=redis://localhost:6379/0

# Phase 11 — Auth
# SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
